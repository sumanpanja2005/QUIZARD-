# ==========================================
# QUIZARD - Full Stack Project .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.local
*/.env.*.local
*.env

# Keep example environment files tracked
!.env.example
!*/.env.example

# Local Database & Storage
data/
*/data/
server/data/
*.sqlite
*.db
*.lock
mongod.lock

# Build Outputs
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
out/
.next/

# Vite & Bundler Caches
.vite/
.vite-temp/
*/.vite/
*/.vite-temp/
.cache/
*/.cache/
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*/coverage/
.nyc_output/

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
