# Server Configuration
PORT=5000
NODE_ENV=development

# Database Options:
# Option A: Local MongoDB (For MongoDB Compass on localhost:27017)
MONGODB_URI=mongodb://127.0.0.1:27017/quizard

# Option B: MongoDB Atlas (Uncomment and replace with your real Atlas cluster URI)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/quizard?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=quizard_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Default Admin Credentials (Auto-created on initial run)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@quizard.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!
